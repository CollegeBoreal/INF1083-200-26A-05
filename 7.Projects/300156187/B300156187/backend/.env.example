# Configuration de la base de données SQL Server
# Copier ce fichier vers .env et remplir les valeurs réelles :
#   cp .env.example .env
# NE JAMAIS commiter le vrai fichier .env (il contient un mot de passe).

# Adresse du serveur SQL Server (localhost si SQL Server est installé sur ce PC)
DB_SERVER=localhost
# Nom de la base de données (créée par sql/schema.sql)
DB_NAME=restaurant_app
# Utilisateur SQL Server (ex. : sa, ou un utilisateur dédié créé dans SSMS)
DB_USER=
# Mot de passe de l'utilisateur SQL Server
DB_PASSWORD=
# Port d'écoute de l'API Express
PORT=3000
